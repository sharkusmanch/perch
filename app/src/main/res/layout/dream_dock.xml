<?xml version="1.0" encoding="utf-8"?>
<!-- keepScreenOn is what holds the screen on while dreaming. -->
<com.nousresearch.dock.dream.DreamRootLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dream_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@color/bg_dark">

    <!-- Widgets / Photos / Clock -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dream_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sits above the pager so it does not move with swipes -->
    <TextView
        android:id="@+id/battery_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:alpha="0.5"
        android:visibility="gone" />

</com.nousresearch.dock.dream.DreamRootLayout>
