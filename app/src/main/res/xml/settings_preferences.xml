<?xml version="1.0" encoding="utf-8" ?>
<!-- Each PreferenceCategory renders as a header above one rounded card of rows
     (see CardPreferenceAdapter). The first row has no category: its own card. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>

    <Preference
        android:key="open_dream_settings"
        android:title="@string/pref_open_dream_settings_title"
        android:summary="@string/pref_open_dream_settings_summary"
        android:icon="@drawable/ic_preview"
    />

    <!-- ===== Display ===== -->
    <PreferenceCategory
        android:title="@string/section_display"
        android:layout="@layout/preference_category_material"
    >

        <SwitchPreferenceCompat
            android:key="@string/pref_key_night_mode"
            android:title="@string/pref_night_mode_title"
            android:summary="@string/pref_night_mode_summary"
            android:icon="@drawable/ic_bedtime"
            android:defaultValue="true"
        />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_oled_mode"
            android:title="@string/pref_oled_title"
            android:summary="@string/pref_oled_summary"
            android:icon="@drawable/ic_brightness_2"
            android:defaultValue="false"
        />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_battery_enabled"
            android:title="@string/pref_battery_title"
            android:summary="@string/pref_battery_summary"
            android:icon="@drawable/ic_battery_full"
            android:defaultValue="true"
        />

    </PreferenceCategory>

    <!-- ===== Clock ===== -->
    <PreferenceCategory
        android:title="@string/section_clock"
        android:layout="@layout/preference_category_material"
    >

        <com.nousresearch.dock.settings.FacePreviewPreference
            android:key="face_preview"
            android:persistent="false"
            android:selectable="false"
        />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_clock_24h"
            android:title="@string/pref_clock_24h_title"
            android:summary="@string/pref_clock_24h_summary"
            android:icon="@drawable/ic_schedule"
            android:defaultValue="true"
        />

        <com.nousresearch.dock.settings.ColorPreference
            android:key="@string/pref_key_face_color_digital"
            android:title="@string/pref_face_color_digital_title"
            android:summary="@string/pref_face_color_digital_summary"
            android:icon="@drawable/ic_palette"
            android:defaultValue="#FFFFFF"
        />

        <com.nousresearch.dock.settings.ColorPreference
            android:key="@string/pref_key_face_color_analog"
            android:title="@string/pref_face_color_analog_title"
            android:summary="@string/pref_face_color_analog_summary"
            android:icon="@drawable/ic_palette"
            android:defaultValue="#FF9F0A"
        />

        <com.nousresearch.dock.settings.ColorPreference
            android:key="@string/pref_key_face_color_float"
            android:title="@string/pref_face_color_float_title"
            android:summary="@string/pref_face_color_float_summary"
            android:icon="@drawable/ic_palette"
            android:defaultValue="#FF6482"
        />

    </PreferenceCategory>

    <!-- ===== Photos ===== -->
    <PreferenceCategory
        android:title="@string/section_slideshow"
        android:layout="@layout/preference_category_material"
    >

        <Preference
            android:key="pick_photos"
            android:title="@string/slideshow_pick_photos"
            android:summary="@string/slideshow_no_photos"
            android:icon="@drawable/ic_photo_library"
        />

        <ListPreference
            android:key="@string/pref_key_slideshow_interval"
            android:title="@string/slideshow_interval"
            android:icon="@drawable/ic_timer"
            android:entries="@array/slideshow_interval_labels"
            android:entryValues="@array/slideshow_interval_values"
            android:defaultValue="60000"
            app:useSimpleSummaryProvider="true"
        />

    </PreferenceCategory>

    <!-- ===== Widgets ===== -->
    <PreferenceCategory
        android:title="@string/section_widgets"
        android:layout="@layout/preference_category_material"
    >

        <ListPreference
            android:key="@string/pref_key_widget_slot_count"
            android:title="@string/widget_slot_count"
            android:icon="@drawable/ic_view_column"
            android:entries="@array/widget_slot_count_labels"
            android:entryValues="@array/widget_slot_count_values"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true"
        />

        <!-- Slot rows: titles, summaries and icons are filled in by SettingsActivity -->
        <Preference
            android:key="manage_slot_1"
            android:icon="@drawable/ic_widgets"
        />

        <ListPreference
            android:key="slot_size_1"
            android:icon="@drawable/ic_aspect_ratio"
            android:entries="@array/slot_size_labels"
            android:entryValues="@array/slot_size_values"
            android:defaultValue="medium"
            app:useSimpleSummaryProvider="true"
        />

        <Preference
            android:key="manage_slot_2"
            android:icon="@drawable/ic_widgets"
            app:isPreferenceVisible="false"
        />

        <ListPreference
            android:key="slot_size_2"
            android:icon="@drawable/ic_aspect_ratio"
            android:entries="@array/slot_size_labels"
            android:entryValues="@array/slot_size_values"
            android:defaultValue="medium"
            app:useSimpleSummaryProvider="true"
            app:isPreferenceVisible="false"
        />

        <Preference
            android:key="manage_slot_3"
            android:icon="@drawable/ic_widgets"
            app:isPreferenceVisible="false"
        />

        <ListPreference
            android:key="slot_size_3"
            android:icon="@drawable/ic_aspect_ratio"
            android:entries="@array/slot_size_labels"
            android:entryValues="@array/slot_size_values"
            android:defaultValue="medium"
            app:useSimpleSummaryProvider="true"
            app:isPreferenceVisible="false"
        />

    </PreferenceCategory>

    <!-- ===== Setup ===== -->
    <PreferenceCategory
        android:title="@string/section_setup"
        android:layout="@layout/preference_category_material"
    >

        <Preference
            android:key="auto_start_guide"
            android:title="@string/pref_autostart_title"
            android:summary="@string/pref_autostart_summary"
            android:icon="@drawable/ic_power_settings_new"
        />

        <Preference
            android:key="about_license"
            android:title="@string/about_license"
            android:summary="@string/about_summary"
            android:icon="@drawable/ic_info"
        />

    </PreferenceCategory>

</PreferenceScreen>
