<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark counterpart of Theme.Dock.Settings (see values/themes.xml). This
         preserves the app's original dark look when the user picks Dark (or
         System while the phone is in dark mode) via the "App theme" pref. -->
    <style name="Theme.Dock.Settings" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_selector</item>
        <item name="android:textColorSecondary">@color/text_secondary_selector</item>
        <item name="android:textColorHint">#6F6E66</item>
        <item name="android:disabledAlpha">0.38</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>
</resources>
