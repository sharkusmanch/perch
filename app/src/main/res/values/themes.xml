<?xml version="1.0" encoding="utf-8" ?>
<resources>
    <!-- Base application theme — used for dream and settings -->
    <style name="Theme.Dock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <!-- Settings theme (light/day default). A dark counterpart lives in
         values-night/themes.xml and is used automatically when the user picks
         Dark (or System while the phone is in dark mode) via the in-app
         "App theme" preference. Explicit text colors are set so Preference row
         titles/summaries always contrast correctly with the background,
         instead of drifting out of sync with a forced background color. -->
    <style
        name="Theme.Dock.Settings"
        parent="Theme.AppCompat.DayNight.NoActionBar"
    >
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/settings_bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:statusBarColor">@color/settings_bg</item>
        <item name="android:navigationBarColor">@color/settings_bg</item>
        <item
            name="android:textColorPrimary"
        >@color/settings_text_primary_selector</item>
        <item
            name="android:textColorSecondary"
        >@color/settings_text_secondary_selector</item>
        <item name="android:textColorHint">@color/settings_text_disabled</item>
        <item name="android:disabledAlpha">0.38</item>
        <item name="android:windowLightStatusBar">true</item>
        <item
            name="preferenceTheme"
        >@style/PreferenceThemeOverlay.v14.Material</item>
    </style>
</resources>
