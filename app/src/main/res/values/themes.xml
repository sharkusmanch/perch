<?xml version="1.0" encoding="utf-8" ?>
<resources>
    <!-- Base application theme — used for the dream -->
    <style name="Theme.Dock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <!-- Settings theme: Material 3, following the system light/dark mode.
         On Android 12+ SettingsActivity also applies the wallpaper-based
         dynamic colors on top of this. -->
    <style name="Theme.Dock.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurfaceContainer</item>
        <item name="preferenceTheme">@style/ThemeOverlay.Dock.Preference</item>
    </style>

    <style name="ThemeOverlay.Dock.Preference" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/Preference.Dock.Switch</item>
    </style>

    <style name="Preference.Dock.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>
</resources>
