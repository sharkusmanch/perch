<resources>
    <!-- Palette ========================================= -->
    <color name="bg_dark">#1e1e1d</color>
    <color name="bg_dark_oled">#000000</color>
    <color name="text_primary">#c3c2b7</color>
    <color name="accent">#d57455</color>
    <!-- Subtle step-up for widget containers -->
    <color name="bg_surface">#2a2a28</color>
    <!-- Scrim overlay for slideshow -->
    <color name="scrim">#80000000</color>

    <!-- Settings app UI palette (light/day default). The dark counterparts
         used when the Settings app theme is Dark (or System follows dark)
         live in values-night/themes.xml, reusing bg_dark/text_primary above.
         The dream/screensaver itself always stays dark regardless of this
         and is unaffected by these tokens. -->
    <color name="settings_bg">#F7F4EF</color>
    <color name="settings_surface">#FFFFFF</color>
    <color name="settings_text_primary">#2B2A28</color>
    <color name="settings_text_secondary">#5B5952</color>
</resources>
